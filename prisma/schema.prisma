generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// Hesabın türü (Issue #46). Banka API entegrasyonu kapsam dışı olduğu için tür yalnızca
// sınıflandırma amaçlıdır; davranışsal bir farkı yoktur. Yeni tür eklemek migration gerektirir
// — bu bilinçlidir: tür kümesi küçük ve kararlıdır (AuditLog.action'daki serbest String
// tercihiyle karşılaştır; oradaki küme sürekli büyüyor).
enum AccountType {
  BANK
  CASH
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  emailVerified        DateTime?
  // null = credential'lar (şifre) hiç değiştirilmedi — bu kullanıcının mevcut hiçbir JWT
  // session'ı geçersiz kılınmaz (bkz. src/lib/auth/session-revocation.ts, Issue #26). Dolu =
  // bu zamandan ÖNCE (`token.iat`) üretilmiş JWT'ler artık kabul edilmez. Password reset (#7)
  // ve gelecekteki authenticated password change (Epic 3) tarafından ORTAK güncellenir
  // (bkz. src/lib/auth/credentials.ts).
  credentialsChangedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     TenantInvitation[]   @relation("InvitationInviter")
  auditLogs           AuditLog[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations TenantInvitation[]
  auditLogs   AuditLog[]
  accounts    Account[]
}

// Bir tenant'ın finansal hesabı: banka hesabı veya kasa (Issue #46).
model Account {
  id   String      @id @default(cuid())
  name String
  type AccountType

  // Para DAİMA Decimal (bkz. docs/security-invariants.md #10): `Float`/`number` kayan nokta
  // yuvarlama hatası üretir ve finansal bir üründe bu kabul edilemez. (19, 4) ölçeği,
  // mevcut para birimlerinin tamamı için yeterli kuruş hassasiyeti + çok büyük tutarlar
  // demektir. Uygulama katmanı bu alanı JSON'a DAİMA string olarak yazar.
  balance Decimal @default(0) @db.Decimal(19, 4)

  // Para birimi tutardan AYRI bir alandır (aynı invariant): ISO 4217 kodu, ör. "TRY", "USD".
  // Tam ISO listesi bir bağımlılık gerektireceği için doğrulama biçimseldir (3 büyük harf);
  // gerçek dünyada geçersiz bir kodun zararı, yanlış bir kur dönüşümü DEĞİL, yalnızca
  // etiketin anlamsız olmasıdır — dönüşüm/çoklu kur bu issue'nun kapsamı dışıdır.
  currency String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Aynı tenant içinde aynı isimde iki hesap olamaz. Bu, "önce kontrol et sonra yaz" yarışını
  // veritabanı seviyesinde kapatır: servis katmanı P2002'yi 409'a çevirir (bkz.
  // src/lib/finance/account.ts). Kıyas büyük/küçük harfe DUYARLIDIR ("Kasa" ile "kasa" ayrı
  // kabul edilir) — Postgres'te case-insensitive unique ayrı bir index/collation gerektirir
  // ve bu issue için gereksiz karmaşıklıktır.
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Raw token asla saklanmaz; sadece SHA-256 hash'i saklanır (bkz. src/lib/auth/password-reset.ts).
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // null = henüz kullanılmadı. Dolu = tek kullanımlık token tüketildi (veya iptal edildi).
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TenantInvitation {
  id    String         @id @default(cuid())
  email String
  role  MembershipRole @default(MEMBER)

  // Raw token asla saklanmaz; sadece SHA-256 hash'i saklanır (bkz. src/lib/tenants/invitation.ts).
  tokenHash   String    @unique
  expiresAt   DateTime
  // null = henüz kullanılmadı. Dolu = tek kullanımlık token tüketildi.
  usedAt      DateTime?
  // null = hâlâ pending. Dolu = aynı tenant+email için yeni bir davet oluşturulduğunda
  // (veya ileride açık bir iptal işlemiyle) geçersiz kılındı.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Daveti gönderen kullanıcı silinirse davet kaydı SetNull ile korunur (audit amaçlı).
  invitedByUserId String?
  invitedByUser   User?   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, email])
}

model AuditLog {
  id String @id @default(cuid())

  // Aktörü (kim) temsil eder; başarısız login gibi olaylarda kullanıcı bilinmediği için
  // nullable. User silinirse denetim kaydı KORUNUR (onDelete: SetNull) — audit trail bir
  // kullanıcı hesabının silinmesiyle kaybolmamalı (bkz. TenantInvitation.invitedByUserId'deki
  // aynı gerekçe, src/lib/tenants/invitation.ts).
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Tenant-bağımsız olaylar (ör. başarısız login) için nullable. Tenant silinirse denetim
  // kaydı KORUNUR (onDelete: SetNull) — aynı gerekçe.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Sabit, stabil event ismi (bkz. src/lib/audit/actions.ts) — merkezi typed constants
  // üzerinden yazılır, serbest metin DEĞİLDİR. Prisma enum yerine String: yeni bir action
  // eklemek migration gerektirmesin diye bilinçli tercih; tip güvenliği uygulama katmanında
  // (`AuditAction` union'ı) sağlanır.
  action String

  // Etkilenen kaynağın türü/ID'si (ör. "USER"/"TENANT"/"MEMBERSHIP"); targetType de action gibi
  // merkezi typed constants'tan gelir.
  targetType String?
  targetId   String?

  // Serbest biçimli ek bağlam. Hassas alanlar (password/token/secret/cookie/...) merkezi
  // `writeAuditLog()` helper'ı tarafından defense-in-depth olarak redakte edilir (bkz.
  // src/lib/audit/sanitize.ts) — çağıran kod da metadata'ya hassas veri KOYMAMALIDIR.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}
