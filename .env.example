# PostgreSQL connection string used by Prisma and the Next.js app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bireysel_kurumsal_finans?schema=public"

# Auth.js (next-auth) - JWT session token'larını imzalamak/şifrelemek için kullanılır.
# Lokal bir değer üretmek için: npx auth secret   (veya: openssl rand -base64 32)
AUTH_SECRET=""

# Used by docker-compose.yml to provision the local PostgreSQL container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bireysel_kurumsal_finans
POSTGRES_PORT=5432
