generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// Hesabın türü (Issue #46). Banka API entegrasyonu kapsam dışı olduğu için tür yalnızca
// sınıflandırma amaçlıdır; davranışsal bir farkı yoktur. Yeni tür eklemek migration gerektirir
// — bu bilinçlidir: tür kümesi küçük ve kararlıdır (AuditLog.action'daki serbest String
// tercihiyle karşılaştır; oradaki küme sürekli büyüyor).
enum AccountType {
  BANK
  CASH
}

// Kategorinin yönü (Issue #49): bir kategori ya gelir ya gider tarafındadır. `AccountType`
// ile aynı gerekçeyle Prisma enum'ıdır — küme küçük ve KARARLIDIR (muhasebede üçüncü bir
// yön yoktur), yeni değer eklemek migration gerektirir ve bu istenen davranıştır.
enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  emailVerified        DateTime?
  // null = credential'lar (şifre) hiç değiştirilmedi — bu kullanıcının mevcut hiçbir JWT
  // session'ı geçersiz kılınmaz (bkz. src/lib/auth/session-revocation.ts, Issue #26). Dolu =
  // bu zamandan ÖNCE (`token.iat`) üretilmiş JWT'ler artık kabul edilmez. Password reset (#7)
  // ve gelecekteki authenticated password change (Epic 3) tarafından ORTAK güncellenir
  // (bkz. src/lib/auth/credentials.ts).
  credentialsChangedAt DateTime?
  // null = kullanıcı hiç "tüm oturumları kapat" demedi (Issue #186). Dolu = bu zamandan ÖNCE
  // üretilmiş JWT'ler artık kabul edilmez. `credentialsChangedAt` ile AYNI mekanizmayı
  // (bkz. src/lib/auth/session-revocation.ts) besler ama AYRI tutulur: şifre değişimi ile
  // kullanıcının kendi iradesiyle yaptığı toplu iptal farklı olaylardır ve tek alana yazmak,
  // "şifre değişti mi" sorusunun cevabını bozardı (audit ve ileride e-posta bildirimi bu ayrımı
  // ister). Karşılaştırma ikisinin EN BÜYÜĞÜ ile yapılır.
  sessionsRevokedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     TenantInvitation[]   @relation("InvitationInviter")
  auditLogs           AuditLog[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  invitations          TenantInvitation[]
  auditLogs            AuditLog[]
  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  debtCredits          DebtCredit[]
  modules              TenantModule[]
  deals                Deal[]
  paymentPlans         PaymentPlan[]
  paymentInstallments  PaymentInstallment[]
  cheques              Cheque[]
}

// Bir tenant'ın finansal hesabı: banka hesabı veya kasa (Issue #46).
model Account {
  id   String      @id @default(cuid())
  name String
  type AccountType

  // Para DAİMA Decimal (bkz. docs/security-invariants.md #10): `Float`/`number` kayan nokta
  // yuvarlama hatası üretir ve finansal bir üründe bu kabul edilemez. (19, 4) ölçeği,
  // mevcut para birimlerinin tamamı için yeterli kuruş hassasiyeti + çok büyük tutarlar
  // demektir. Uygulama katmanı bu alanı JSON'a DAİMA string olarak yazar.
  balance Decimal @default(0) @db.Decimal(19, 4)

  // Hesabın bağlı olduğu banka (Issue #148). YALNIZCA `type = BANK` için anlamlıdır; `CASH`
  // hesapta daima `null`dur ve servis katmanı tür `CASH`e çevrildiğinde bu alanı temizler.
  //
  // ENUM DEĞİL, `String?`: `AccountType`/`CategoryType` enum'dur çünkü kümeleri küçük ve
  // KARARLIDIR. Banka listesi ikisi de değildir — birleşme, yeni lisans ve marka değişimi olur;
  // enum, her banka değişikliğinde bir migration demekti. (`AuditLog.action`'daki serbest String
  // tercihiyle aynı gerekçe.)
  //
  // Saklanan değer bir KOD'dur (`ZIRAAT`, `GARANTI`), görünen ad değil: marka değişimleri veri
  // migration'ı gerektirmemeli. Doğrulama uygulama katmanındaki ALLOWLIST'tedir
  // (src/lib/finance/banks.ts) — serbest metin kabul edilmez, aksi halde "Garanti",
  // "garanti bankası" ve "TGB" üç ayrı banka olurdu.
  //
  // `null` = belirtilmemiş. #148 ÖNCESİNDE oluşturulmuş banka hesapları bu durumdadır ve
  // geçerli sayılırlar; alanı zorunlu yapmak mevcut satırları ve API sözleşmesini kırardı
  // (bkz. README, "#148 kararları").
  bankCode String?

  // Para birimi tutardan AYRI bir alandır (aynı invariant): ISO 4217 kodu, ör. "TRY", "USD".
  // Tam ISO listesi bir bağımlılık gerektireceği için doğrulama biçimseldir (3 büyük harf);
  // gerçek dünyada geçersiz bir kodun zararı, yanlış bir kur dönüşümü DEĞİL, yalnızca
  // etiketin anlamsız olmasıdır — dönüşüm/çoklu kur bu issue'nun kapsamı dışıdır.
  currency String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Aynı tenant içinde aynı isimde iki hesap olamaz. Bu, "önce kontrol et sonra yaz" yarışını
  // veritabanı seviyesinde kapatır: servis katmanı P2002'yi 409'a çevirir (bkz.
  // src/lib/finance/account.ts). Kıyas büyük/küçük harfe DUYARLIDIR ("Kasa" ile "kasa" ayrı
  // kabul edilir) — Postgres'te case-insensitive unique ayrı bir index/collation gerektirir
  // ve bu issue için gereksiz karmaşıklıktır.
  @@unique([tenantId, name])
  @@index([tenantId])
}

// Bir tenant'ın gelir/gider kategorisi (Issue #49). İşlemlerin (#53) sınıflandırılmasında
// kullanılacak DÜZ bir listedir; alt kategori hiyerarşisi bilinçli olarak kapsam dışıdır.
model Category {
  id   String       @id @default(cuid())
  name String
  type CategoryType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Unique anahtar `Account`takinden FARKLI olarak TÜRÜ de içerir: "Diğer", "Faiz", "Kira"
  // gibi isimler hem gelir hem gider tarafında doğal olarak bulunur; bunları tek bir isim
  // uzayına sıkıştırmak kullanıcıyı "Diğer (Gelir)" gibi kaçamak isimlere zorlardı.
  // Belirsizlik doğmaz: kategori daima bir türün bağlamında seçilir (gider işlemine gider
  // kategorisi). Yarış durumu yine DB'de kapatılır — servis P2002'yi 409'a çevirir (bkz.
  // src/lib/finance/category.ts). Kıyas büyük/küçük harfe DUYARLIDIR (Account ile aynı sınır).
  @@unique([tenantId, type, name])
  @@index([tenantId])
}

// Bir tenant'ın gelir/gider işlemi (Issue #53): paranın gerçekten hareket ettiği kayıt.
// `Account.balance` bu kayıtlardan TÜRETİLİR — işlem oluşturma/güncelleme/silme, bakiyeyi aynı
// DB transaction'ı içinde günceller (bkz. src/lib/finance/transaction.ts).
model Transaction {
  id String @id @default(cuid())

  // Yön (para giriyor mu çıkıyor mu). `CategoryType` BİLEREK yeniden kullanılır, ayrı bir
  // `TransactionType` enum'ı TANIMLANMAZ: bu tek bir alan adı meselesi değil, iki değerin
  // KARŞILAŞTIRILMASI meselesidir — bir gider işlemine yalnızca gider kategorisi seçilebilir
  // (bkz. README "?type filtresi"). İkiz bir enum, tam da bu karşılaştırmanın yapıldığı yerde
  // TypeScript'i bir cast'e zorlardı; aynı domain kavramı için iki tip tutmanın bedeli budur.
  type CategoryType

  // Tutar DAİMA POZİTİFTİR; yönü `type` taşır (servis katmanı 0 ve negatifi 400 ile reddeder).
  // Negatif bir EXPENSE, kılık değiştirmiş bir gelir olurdu ve "toplam gider" gibi her toplamı
  // sessizce bozardı. Ölçek `Account.balance` ile aynı: (19, 4) — bkz. invariant #10.
  amount Decimal @db.Decimal(19, 4)

  // Kullanıcının serbest notu (ör. "Ocak kirası"). null = not girilmemiş; boş string DEĞİL
  // (servis katmanı boş/boşluk-only notu `null`a indirger — "yok" için tek bir gösterim).
  description String?

  // İşlemin GERÇEKLEŞTİĞİ an — `createdAt` (kaydın SİSTEME girildiği an) ile karıştırılmamalı.
  // Geçmişe dönük kayıt girmek normaldir, bu yüzden ikisi ayrı alandır. İstemci göndermezse
  // "şimdi" varsayılır: işlem formunun doğal varsayılanı bugündür.
  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Paranın hareket ettiği hesap ZORUNLUDUR — bakiyesi bu kayıtlardan türetildiği için
  // hesapsız bir işlemin anlamı yoktur.
  //
  // `onDelete: NoAction`: işlemi olan bir hesap SİLİNEMEZ (servis P2003'ü 409'a çevirir).
  // Cascade REDDEDİLDİ — bir hesabı silmek, o hesabın tüm finansal geçmişini sessizce yok
  // ederdi. `Restrict` DEĞİL `NoAction`: ikisi de aynı engeli koyar, ama Postgres'te
  // `RESTRICT` kontrolü ERTELENEMEZ; tenant silindiğinde tenant→account ve tenant→transaction
  // cascade'leri AYNI ifadede çalışır ve `RESTRICT` bu meşru durumu da hatayla keserdi.
  // `NO ACTION` kontrolü ifade sonunda yapar, dolayısıyla tenant silme çalışmaya devam eder
  // (kanıt: integration/transaction.spec.ts'teki cascade testi).
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: NoAction)

  // Kategori OPSİYONELDİR: sınıflandırma sonradan da yapılabilir, kayıt bunu beklemez.
  // `onDelete: SetNull`: kategori silinince işlem "kategorisiz" kalır, SİLİNMEZ. Hesabın
  // aksine kategori paranın kendisi değil bir ETİKETTİR; tek bir eski işlem yüzünden bir
  // etiketi sonsuza dek tutmaya zorlamak yanlış olurdu (bkz. README, Issue #49'un açık bıraktığı
  // karar burada veriliyor).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Listeleme daima tenant içinde ve tarihe göre azalan sırada yapılır; bileşik index ikisini
  // birden karşılar. Ayrı bir `@@index([tenantId])` YOKTUR — bileşik index'in en soldaki
  // sütunu zaten tenantId'dir, ikincisi yalnızca yazma maliyeti eklerdi.
  @@index([tenantId, occurredAt])
  // FK sütunlarına index: Postgres FK'leri otomatik indexlemez. Hesap silinirken yapılan
  // "işlemi var mı" kontrolü ve kategori silinirken yapılan SetNull taraması bunlara dayanır.
  @@index([accountId])
  @@index([categoryId])
}

// Borcun yönü (Issue #70): `DEBT` = tenant BORÇLU, `CREDIT` = tenant ALACAKLI.
//
// `AccountType`/`CategoryType` ile aynı gerekçeyle Prisma enum'ıdır: küme küçük ve KARARLIDIR
// (bir kaydın üçüncü bir yönü yoktur). `Account.bankCode`taki serbest `String` tercihiyle
// karşılaştır — orada küme büyüyor, burada büyümüyor.
enum DebtCreditType {
  DEBT
  CREDIT
}

// Kaydın durumu (Issue #70). `SETTLED` = kapandı (ödendi/tahsil edildi).
//
// Ara durum (`PARTIAL`) BİLEREK YOKTUR: kısmi ödeme, kalan tutarın ne olduğunu ve ödemelerin
// nerede tutulacağını sorar — yani ayrı bir "ödeme" kaydı ve bakiye mantığı demektir. Bugün
// istenmiyor; eklenirse bu enum'a bir değer eklemek yetmez, yeni bir model gerekir.
enum DebtCreditStatus {
  OPEN
  SETTLED
}

/// Tenant'ın borç/alacak kaydı (Issue #70): "kime ne kadar borçluyum / kimden ne kadar
/// alacağım". `Transaction`dan FARKI, paranın henüz HAREKET ETMEMİŞ olmasıdır — bu yüzden
/// hiçbir hesabın bakiyesini etkilemez ve `Account` ile ilişkisi yoktur.
model DebtCredit {
  id   String         @id @default(cuid())
  type DebtCreditType

  // Karşı taraf: kişi ya da kurum adı. Serbest metindir ve bir `Contact` modeline
  // BAĞLANMAZ — kişi/kurum rehberi ayrı bir kavramdır ve bu issue'nun kapsamında değildir.
  counterparty String

  // Tutar DAİMA POZİTİFTİR; yönü `type` taşır — `Transaction.amount` ile birebir aynı kural
  // (#53). Negatif bir `DEBT`, kılık değiştirmiş bir alacak olurdu ve her toplamı bozardı.
  // Ölçek de aynı: (19, 4).
  amount Decimal @db.Decimal(19, 4)

  // Para birimi tutardan AYRI alandır (invariant #10). ISSUE'NUN ALAN LİSTESİNDE YOKTU ve
  // BİLEREK EKLENDİ: para birimi olmayan bir tutar, üründeki hiçbir ekranda güvenle
  // gösterilemez (bkz. README, panelin çok para birimli kararları). Kur dönüşümü yine yok;
  // toplamlar para birimi bazında ayrılır.
  currency String

  // Vade. OPSİYONELDİR: "borçluyum ama tarihi belli değil" meşru bir kayıttır ve kullanıcıyı
  // uydurma bir tarih girmeye zorlamak, veriyi sessizce bozardı. Gün hassasiyetinde saklanır
  // (UTC gece yarısı) — saat dilimi yönetimi hâlâ yok (#134).
  dueDate DateTime?

  status DebtCreditStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Listeleme daima tenant içinde, önce açık kayıtlar ve vadeye göre yapılır; bileşik index
  // hem filtreyi hem sıralamayı karşılar. `Account`taki gibi ayrı bir `@@index([tenantId])`
  // YOKTUR — bileşik index'in en soldaki sütunu zaten tenantId'dir.
  @@index([tenantId, status, dueDate])
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Raw token asla saklanmaz; sadece SHA-256 hash'i saklanır (bkz. src/lib/auth/password-reset.ts).
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // null = henüz kullanılmadı. Dolu = tek kullanımlık token tüketildi (veya iptal edildi).
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TenantInvitation {
  id    String         @id @default(cuid())
  email String
  role  MembershipRole @default(MEMBER)

  // Raw token asla saklanmaz; sadece SHA-256 hash'i saklanır (bkz. src/lib/tenants/invitation.ts).
  tokenHash   String    @unique
  expiresAt   DateTime
  // null = henüz kullanılmadı. Dolu = tek kullanımlık token tüketildi.
  usedAt      DateTime?
  // null = hâlâ pending. Dolu = aynı tenant+email için yeni bir davet oluşturulduğunda
  // (veya ileride açık bir iptal işlemiyle) geçersiz kılındı.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Daveti gönderen kullanıcı silinirse davet kaydı SetNull ile korunur (audit amaçlı).
  invitedByUserId String?
  invitedByUser   User?   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, email])
}

model AuditLog {
  id String @id @default(cuid())

  // Aktörü (kim) temsil eder; başarısız login gibi olaylarda kullanıcı bilinmediği için
  // nullable. User silinirse denetim kaydı KORUNUR (onDelete: SetNull) — audit trail bir
  // kullanıcı hesabının silinmesiyle kaybolmamalı (bkz. TenantInvitation.invitedByUserId'deki
  // aynı gerekçe, src/lib/tenants/invitation.ts).
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Tenant-bağımsız olaylar (ör. başarısız login) için nullable. Tenant silinirse denetim
  // kaydı KORUNUR (onDelete: SetNull) — aynı gerekçe.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Sabit, stabil event ismi (bkz. src/lib/audit/actions.ts) — merkezi typed constants
  // üzerinden yazılır, serbest metin DEĞİLDİR. Prisma enum yerine String: yeni bir action
  // eklemek migration gerektirmesin diye bilinçli tercih; tip güvenliği uygulama katmanında
  // (`AuditAction` union'ı) sağlanır.
  action String

  // Etkilenen kaynağın türü/ID'si (ör. "USER"/"TENANT"/"MEMBERSHIP"); targetType de action gibi
  // merkezi typed constants'tan gelir.
  targetType String?
  targetId   String?

  // Serbest biçimli ek bağlam. Hassas alanlar (password/token/secret/cookie/...) merkezi
  // `writeAuditLog()` helper'ı tarafından defense-in-depth olarak redakte edilir (bkz.
  // src/lib/audit/sanitize.ts) — çağıran kod da metadata'ya hassas veri KOYMAMALIDIR.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

/// Bir tenant'ta bir modülün açık olup olmadığı (Issue #151).
model TenantModule {
  id String @id @default(cuid())

  moduleKey String
  enabled Boolean @default(true)
  settings Json?
  seededAt DateTime?
  enabledAt DateTime?
  disabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

// CRM Süreç Takibi (Issue #158 / Epic 14): Ödeme planına bağlanan satış süreci modeli.
model Deal {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plans PaymentPlan[]

  @@index([tenantId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHEQUE
  MIXED
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

// Tahsilat Ödeme Planı (Issue #165).
model PaymentPlan {
  id               String            @id @default(cuid())
  totalAmount      Decimal           @db.Decimal(19, 4)
  currency         String
  method           PaymentMethod
  downPayment      Decimal           @default(0) @db.Decimal(19, 4)
  installmentCount Int
  status           PaymentPlanStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: NoAction)

  installments PaymentInstallment[]
  cheques      Cheque[]

  @@index([tenantId])
  @@index([dealId])
}

// Tahsilat Taksidi (Issue #165).
model PaymentInstallment {
  id         String            @id @default(cuid())
  sequence   Int
  dueDate    DateTime
  amount     Decimal           @db.Decimal(19, 4)
  paidAmount Decimal           @default(0) @db.Decimal(19, 4)
  status     InstallmentStatus @default(PENDING)
  paidAt     DateTime?
  method     PaymentMethod?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  transactionId String?  @unique
  cheques       Cheque[]

  @@unique([planId, sequence])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

// Çek Modeli (Issue #165 / Issue #167 relation).
model Cheque {
  id           String   @id @default(cuid())
  chequeNumber String
  bankName     String
  dueDate      DateTime
  amount       Decimal  @db.Decimal(19, 4)
  currency     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String?
  plan   PaymentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  installmentId String?
  installment   PaymentInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([installmentId])
}
