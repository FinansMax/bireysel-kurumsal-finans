# PostgreSQL connection string used by Prisma and the Next.js app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bireysel_kurumsal_finans?schema=public"

# Auth.js (next-auth) - JWT session token'larını imzalamak/şifrelemek için kullanılır.
# Lokal bir değer üretmek için: npx auth secret   (veya: openssl rand -base64 32)
AUTH_SECRET=""

# Uygulamanın dışarıya görünen kök adresi. Şifre sıfırlama ve tenant daveti E-POSTALARINDAKİ
# mutlak linkler bu değerden üretilir (bkz. src/lib/config/app-url.ts).
# PRODUCTION'DA ZORUNLUDUR: ayarlanmazsa uygulama bilerek hata verir, çünkü aksi halde
# kullanıcılara çalışmayan localhost linkleri gönderilirdi. Lokalde boş bırakılabilir;
# o durumda http://localhost:3000 kullanılır. Mutlak bir http(s) URL olmalıdır.
APP_BASE_URL=""

# Used by docker-compose.yml to provision the local PostgreSQL container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bireysel_kurumsal_finans
POSTGRES_PORT=5432

# E-posta sağlayıcısı (bkz. src/lib/config/email.ts, Issue #180).
# console = gerçek gönderim YOK; loglar ve (production dışında) .test-outbox dizinine yazar.
# resend  = Resend HTTP API üzerinden gerçek gönderim.
# PRODUCTION'DA "console" VEYA BOŞ BIRAKILAMAZ: uygulama bilerek hata verir, çünkü aksi halde
# şifre sıfırlama ve davet e-postaları sessizce hiç gönderilmez ve bu fark edilmez.
EMAIL_PROVIDER="console"

# Sağlayıcı API anahtarı. EMAIL_PROVIDER=resend ise ZORUNLUDUR.
# GİZLİDİR: NEXT_PUBLIC_ önekiyle tanımlanmaz, loglanmaz, commit edilmez (invariant #5).
EMAIL_API_KEY=""

# Gönderen adresi. EMAIL_PROVIDER=resend ise ZORUNLUDUR.
# Alan adının sağlayıcıda doğrulanmış olması gerekir (SPF/DKIM kurulumu bir deployment adımıdır).
EMAIL_FROM="FinansMax <no-reply@example.com>"
